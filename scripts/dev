#!/bin/sh

set -eu

cd "$(dirname "$0")/.."

edge_enabled() {
  test -f .env && grep -qx 'DEV_EDGE=true' .env
}

compose() {
  if ! command -v docker >/dev/null 2>&1; then
    echo 'Docker is required. Start Docker Desktop and try again.' >&2
    exit 1
  fi

  if test ! -f .env; then
    echo 'Missing .env. Copy .env.example and migrate the protected development values first.' >&2
    exit 1
  fi

  project=${COMPOSE_PROJECT_NAME:-jaysylvester}

  # DEV_EDGE=true in .env joins the shared workstation edge proxy so several
  # stacks can run at once; see compose.dev.edge.yaml. Unset = standalone.
  edge_file=
  if edge_enabled; then
    edge_file=compose.dev.edge.yaml
  fi

  docker compose \
    --env-file .env \
    -p "$project" \
    -f compose.yaml \
    -f compose.dev.yaml \
    ${edge_file:+-f "$edge_file"} \
    "$@"
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo 'Docker is required. Start Docker Desktop and try again.' >&2
    exit 1
  fi

  if ! docker info >/dev/null 2>&1; then
    echo 'Docker Desktop is not running or not ready. Start Docker Desktop and try again.' >&2
    exit 1
  fi
}

start_edge() {
  edge_enabled || return 0

  edge=$HOME/Projects/dev-edge/edge
  if test ! -x "$edge"; then
    echo "DEV_EDGE=true but $edge was not found. Unset DEV_EDGE to run standalone." >&2
    exit 1
  fi

  if ! "$edge" start >/dev/null 2>&1; then
    echo "The dev-edge proxy failed to start; run $edge start to see why." >&2
    exit 1
  fi
}

prepare_routing() {
  if edge_enabled; then
    start_edge
    return
  fi

  if docker ps \
    --filter label=com.docker.compose.project=dev-edge \
    --filter label=com.docker.compose.service=edge \
    --format '{{.ID}}' | grep -q .; then
    echo 'The shared dev-edge proxy is already using localhost ports 80/443.' >&2
    echo 'Set DEV_EDGE=true in .env, or stop it with ~/Projects/dev-edge/edge stop.' >&2
    exit 1
  fi
}

start() {
  require_docker
  compose config --quiet
  prepare_routing
  mkdir -p logs
  ./scripts/dev-cert
  ./scripts/dev-db-initialize
  compose up "$@"
}

usage() {
  cat <<'EOF'
Usage: ./scripts/dev COMMAND [ARGUMENTS]

Commands:
  start [arguments]        Start attached (use --build to rebuild)
  stop [services]          Stop without removing containers
  restart [arguments]      Stop, then start attached
  status                   Show all service states
  logs                     Follow app, proxy, assets, and database logs
  test                     Run the development smoke test
  destroy                  Remove containers/network; preserve volumes
  db-backup                Create and verify a logical database backup
  db-restore ARCHIVE       Restore one verified development database backup
  postgres-password       Change the postgres password through a hidden prompt
  compose [arguments]      Run development Docker Compose directly
EOF
}

subcommand=${1:-}

if test -z "$subcommand"; then
  usage >&2
  exit 1
fi

shift

case "$subcommand" in
  start)
    start "$@"
    ;;
  stop)
    compose stop "$@"
    ;;
  restart)
    compose stop
    start "$@"
    ;;
  status)
    compose ps --all "$@"
    ;;
  logs)
    compose logs -f app proxy assets db "$@"
    ;;
  test)
    exec ./scripts/smoke-test https://dev.jaysylvester.com "$@"
    ;;
  destroy)
    compose down "$@"
    ;;
  db-backup)
    exec ./scripts/dev-db-backup "$@"
    ;;
  db-restore)
    exec ./scripts/dev-db-restore "$@"
    ;;
  postgres-password)
    compose exec db \
      psql --username postgres --dbname postgres --command '\password postgres'
    ;;
  compose)
    case "${1:-}" in
      up|start)
        require_docker
        compose config --quiet
        prepare_routing
        ;;
    esac
    compose "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown development command: $subcommand" >&2
    usage >&2
    exit 1
    ;;
esac
