#!/bin/sh

set -eu

cd "$(dirname "$0")/.."

edge_enabled() {
  test -f .env && grep -qx 'DEV_EDGE=true' .env
}

compose() {
  if ! command -v docker >/dev/null 2>&1; then
    echo 'Docker is required. Start Docker Desktop and try again.' >&2
    exit 1
  fi

  if test ! -f .env; then
    echo 'Missing .env. Migrate the protected source config first.' >&2
    exit 1
  fi

  project=${COMPOSE_PROJECT_NAME:-jaysylvester}

  # DEV_EDGE=true in .env joins the shared workstation edge proxy so several
  # stacks can run at once; see compose.dev.edge.yaml. Unset = standalone.
  edge_file=
  if edge_enabled; then
    edge_file=compose.dev.edge.yaml
  fi

  docker compose \
    --env-file .env \
    -p "$project" \
    -f compose.yaml \
    -f compose.dev.yaml \
    ${edge_file:+-f "$edge_file"} \
    "$@"
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo 'Docker is required. Start Docker Desktop and try again.' >&2
    exit 1
  fi

  if ! docker info >/dev/null 2>&1; then
    echo 'Docker Desktop is not running or not ready. Start Docker Desktop and try again.' >&2
    exit 1
  fi
}

start_edge() {
  edge_enabled || return 0

  edge=$HOME/Projects/dev-edge/edge
  if test ! -x "$edge"; then
    echo "DEV_EDGE=true but $edge was not found. Unset DEV_EDGE to run standalone." >&2
    exit 1
  fi

  if ! "$edge" start >/dev/null 2>&1; then
    echo "The dev-edge proxy failed to start; run $edge start to see why." >&2
    exit 1
  fi
}

prepare_routing() {
  if edge_enabled; then
    start_edge
    return
  fi

  if docker ps \
    --filter label=com.docker.compose.project=dev-edge \
    --filter label=com.docker.compose.service=edge \
    --format '{{.ID}}' | grep -q .; then
    echo 'The shared dev-edge proxy is already using localhost ports 80/443.' >&2
    echo 'Set DEV_EDGE=true in .env, or stop it with ~/Projects/dev-edge/edge stop.' >&2
    exit 1
  fi
}

start() {
  update_dependencies=
  expect_update=false
  for argument do
    shift
    if test "$expect_update" = true; then
      case "$argument" in
        ''|-*|*[!a-zA-Z0-9@._/-]*)
          echo '--update requires a dependency name, such as citizen or @scope/package.' >&2
          return 1
          ;;
      esac
      update_dependencies="$update_dependencies --update $argument"
      expect_update=false
      continue
    fi
    case "$argument" in
      --update) expect_update=true ;;
      --build) ;; # The wrapper already builds before Compose up.
      *) set -- "$@" "$argument" ;;
    esac
  done
  if test "$expect_update" = true; then
    echo '--update requires a dependency name.' >&2
    return 1
  fi

  require_docker
  compose config --quiet
  # Names are validated above; splitting these build arguments is intentional.
  ./scripts/build $update_dependencies
  prepare_routing
  mkdir -p logs
  ./scripts/dev-cert
  ./scripts/dev-db-initialize
  compose up --no-build "$@"
}

restart() {
  if test "$#" -eq 0; then set -- app proxy assets; fi
  restart_database=false
  recreate_services=
  for service do
    case "$service" in
      app|proxy|assets) recreate_services="$recreate_services $service" ;;
      db) restart_database=true ;;
      *) echo "Unknown development service: $service" >&2; return 1 ;;
    esac
  done

  require_docker
  compose config --quiet
  if test -n "$recreate_services"; then
    ./scripts/build
    prepare_routing
  fi
  if test "$restart_database" = true; then compose restart db; fi
  if test -n "$recreate_services"; then
    # Service names are validated above; splitting this list is intentional.
    compose up --detach --no-build --no-deps --force-recreate $recreate_services
  fi
}

usage() {
  cat <<'EOF'
Usage: ./scripts/dev COMMAND [ARGUMENTS]

Commands:
  build [arguments]             Prepare dependencies and build development images
  start [arguments]             Sync dependencies, build, and start attached
                                --update PACKAGE refreshes a declared dependency
                                -d runs detached; other arguments go to Compose
  stop [services]               Stop without removing containers
  restart [services]            Sync, build, and recreate selected services
  status                        Show all service states
  logs                          Follow app, proxy, assets, and database logs
  test                          Run the development smoke test
  destroy                       Remove containers/network; preserve volumes
  db-backup                     Create and verify a logical database backup
  db-restore ARCHIVE            Restore into an empty development database
  postgres-password             Change the postgres password through a hidden prompt
  compose [arguments]           Run development Docker Compose directly
EOF
}

subcommand=${1:-}

if test -z "$subcommand"; then
  usage >&2
  exit 1
fi

shift

case "$subcommand" in
  build)
    exec ./scripts/build "$@"
    ;;
  start)
    start "$@"
    ;;
  stop)
    compose stop "$@"
    ;;
  restart)
    restart "$@"
    ;;
  status)
    compose ps --all "$@"
    ;;
  logs)
    compose logs -f app proxy assets db "$@"
    ;;
  test)
    exec ./scripts/smoke-test https://dev.jaysylvester.com "$@"
    ;;
  destroy)
    if test "$#" -ne 0; then
      echo 'destroy does not accept arguments; named volumes are always preserved.' >&2
      exit 1
    fi
    compose down
    ;;
  db-backup)
    exec ./scripts/dev-db-backup "$@"
    ;;
  db-restore)
    exec ./scripts/dev-db-restore "$@"
    ;;
  postgres-password)
    compose exec db \
      psql --username postgres --dbname postgres --command '\password postgres'
    ;;
  compose)
    case "${1:-}" in
      up|start)
        require_docker
        compose config --quiet
        prepare_routing
        ;;
    esac
    compose "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown development command: $subcommand" >&2
    usage >&2
    exit 1
    ;;
esac
