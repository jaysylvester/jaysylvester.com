#!/bin/sh

set -eu
cd "$(dirname "$0")/.."

dependency_image=jaysylvester-dependency-tools:development
check=false
use_sudo=false
expect_update=false
refresh=false
for argument do
  shift
  if test "$expect_update" = true; then
    case "$argument" in
      ''|-*) echo '--update requires a dependency name.' >&2; exit 1 ;;
    esac
    set -- "$@" --update "$argument"
    expect_update=false
    refresh=true
    continue
  fi
  case "$argument" in
    --check) check=true ;;
    --update) expect_update=true ;;
    --sudo) use_sudo=true ;;
    *) echo "Unknown dependency argument: $argument" >&2; exit 1 ;;
  esac
done

if test "$expect_update" = true; then
  echo '--update requires a dependency name.' >&2
  exit 1
fi
if test "$check" = true && test "$refresh" = true; then
  echo '--check cannot be combined with --update.' >&2
  exit 1
fi

docker_command() {
  if test "$use_sudo" = true; then sudo docker "$@"; else docker "$@"; fi
}

docker_command build --target dependency-tools --tag "$dependency_image" .
mount=$PWD:/site
if test "$check" = true; then
  set -- --check
  mount=$mount:ro
fi
docker_command run --rm \
  --user "$(id -u):$(id -g)" \
  --env NPM_CONFIG_CACHE=/tmp/npm-cache \
  --volume "$mount" \
  "$dependency_image" node ./scripts/dev-dependencies.mjs "$@"
