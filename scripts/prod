#!/bin/sh

set -eu
cd "$(dirname "$0")/.."

usage() {
  cat <<'EOF'
Usage: ./scripts/prod COMMAND [ARGUMENTS]

Commands:
  deploy                  Pull, build, recreate app/proxy, and smoke-test
  start [arguments]       Start the production stack detached
  stop [services]         Stop services without removing containers
  restart [services]      Restart services without rebuilding images
  status                  Show all service states
  logs                    Follow app, proxy, and database logs
  test                    Run the production smoke test
  app-password            Change the DB_USER password through a hidden prompt
  postgres-password       Change the postgres password through a hidden prompt
  compose [arguments]     Run Docker Compose against the production project

There is intentionally no production destroy command.
EOF
}

compose() {
  sudo docker compose \
    --env-file .env \
    -p jaysylvester \
    -f compose.yaml \
    -f compose.production.yaml \
    "$@"
}

command=${1:-}

if test -z "$command"; then
  usage >&2
  exit 1
fi

shift

case "$command" in
  deploy)
    if test "$#" -ne 0; then
      echo 'The production deploy command does not accept arguments.' >&2
      exit 1
    fi
    exec ./scripts/deploy-production
    ;;
  start)
    compose up -d "$@" --no-build --pull never --no-recreate
    ;;
  stop)
    compose stop "$@"
    ;;
  restart)
    if test "$#" -eq 0; then set -- app proxy; fi
    for service do
      case "$service" in
        app|proxy|db) ;;
        *) echo "Unknown production service: $service" >&2; exit 1 ;;
      esac
    done
    compose restart "$@"
    ;;
  status)
    compose ps --all "$@"
    ;;
  logs)
    compose logs -f app proxy db "$@"
    ;;
  test)
    export SMOKE_PRODUCTION=true
    exec ./scripts/smoke-test https://jaysylvester.com "$@"
    ;;
  app-password)
    if test "$#" -ne 0; then
      echo 'app-password does not accept arguments; enter the password at the hidden prompt.' >&2
      exit 1
    fi
    app_user=$(compose config --environment | sed -n 's/^DB_USER=//p')
    case "$app_user" in
      ''|postgres|*[!a-zA-Z0-9_.-]*)
        echo 'DB_USER must name an application role using letters, numbers, underscores, dots, or hyphens; it must not be postgres.' >&2
        exit 1
        ;;
    esac
    compose exec db \
      psql --username postgres --dbname postgres --command "\password \"$app_user\""
    ;;
  postgres-password)
    compose exec db \
      psql --username postgres --dbname postgres --command '\password postgres'
    ;;
  compose)
    compose "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown production command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
