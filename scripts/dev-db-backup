#!/bin/sh

set -eu
cd "$(dirname "$0")/.."

backup_parent=${DEV_DB_BACKUP_PARENT:-"${HOME:?HOME must be set}/Documents/jaysylvester-docker-migration-dev"}
backup_directory=$backup_parent/backups
timestamp=$(date '+%Y%m%d-%H%M%S')
backup_file=$backup_directory/jaysylvester-$timestamp.dump
checksum_file=$backup_file.sha256
temporary_backup=
temporary_checksum=
published_backup=false

dc() {
  ./scripts/dev compose "$@"
}

cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if test -n "$temporary_backup"; then rm -f "$temporary_backup"; fi
  if test -n "$temporary_checksum"; then rm -f "$temporary_checksum"; fi
  if test "$status" -ne 0 && test "$published_backup" = true; then
    rm -f "$backup_file" "$checksum_file"
  fi
  exit "$status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

dc config --quiet

if ! dc ps --status running --services db | grep -qx db; then
  echo 'The development database is not running. Run ./scripts/dev start, then try again.' >&2
  exit 1
fi

umask 077
mkdir -p "$backup_parent" "$backup_directory"
chmod 0700 "$backup_parent" "$backup_directory"

if test -e "$backup_file" || test -e "$checksum_file"; then
  echo "A backup already exists for timestamp $timestamp. Try again in one second." >&2
  exit 1
fi

temporary_backup=$(mktemp "$backup_directory/.jaysylvester-$timestamp.XXXXXX")
chmod 0600 "$temporary_backup"

echo 'Creating PostgreSQL backup...'
dc exec -T db sh -c \
  'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --format=custom --no-owner --no-privileges --serializable-deferrable' \
  > "$temporary_backup"

if test ! -s "$temporary_backup"; then
  echo 'PostgreSQL produced an empty backup.' >&2
  exit 1
fi

echo 'Verifying backup archive...'
dc exec -T db pg_restore --list < "$temporary_backup" >/dev/null

temporary_checksum=$(mktemp "$backup_directory/.checksum.XXXXXX")
checksum=$(shasum -a 256 "$temporary_backup")
printf '%s  %s\n' "${checksum%% *}" "$backup_file" > "$temporary_checksum"
chmod 0600 "$temporary_backup" "$temporary_checksum"
mv "$temporary_backup" "$backup_file"
temporary_backup=
published_backup=true
mv "$temporary_checksum" "$checksum_file"
temporary_checksum=

echo "Backup: $backup_file"
echo "Checksum: $checksum_file"
