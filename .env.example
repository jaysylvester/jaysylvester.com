# Development secrets and deployment inputs. Citizen loads this file from the
# read-only development bind mount. Production must set NODE_ENV=production and
# must not mount or inject its complete .env into app.
NODE_ENV=development
BROWSERSYNC_ORIGIN=https://dev.jaysylvester.com

# Shared application/PostgreSQL deployment inputs. Typed database settings live
# in citizen.config.js. Production exposes DB_PASSWORD through a Compose secret.
DB_DATABASE=jaysylvester
DB_USER=jaysylvester
DB_PASSWORD=REPLACE_WITH_EXISTING_DEV_PASSWORD

# Application mail secret. Non-secret mail settings live in citizen.config.js.
MAIL_AUTH_PASS=REPLACE_WITH_EXISTING_MAIL_PASSWORD

# Docker and PostgreSQL initialization. PostgreSQL 17 is the rehearsed target
# for the legacy PostgreSQL 13 database and preserves its encoding, locale,
# and timezone.
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=en_US.UTF-8
POSTGRES_TIMEZONE=America/New_York
POSTICO_PORT=5432

# Development BrowserSync and Gulp inputs (the assets service receives only these).
GULP_USE_POLLING=true
GULP_POLLING_INTERVAL=500
