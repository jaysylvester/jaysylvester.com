# Citizen 2.0 framework settings
# Development Compose explicitly uses development mode. Set this to production only
# for the temporarily non-containerized Phase 1 production application.
CITIZEN_MODE=development
CITIZEN_HTTP__HOSTNAME=
CITIZEN_HTTP__PORT=8080
CITIZEN_LAYOUT__CONTROLLER=_layout
CITIZEN_TEMPLATE_ENGINE=handlebars
CITIZEN_CORS='{"Access-Control-Allow-Origin":"https://dev.jaysylvester.com","Access-Control-Allow-Methods":"POST, GET, OPTIONS"}'
CITIZEN_DEVELOPMENT__WATCHER__USE_POLLING=true
CITIZEN_DEVELOPMENT__WATCHER__INTERVAL=500

# Application database settings
# Password values remain in this protected host file as Compose secret sources;
# they are mounted into authorized containers under /run/secrets.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=jaysylvester
DB_USER=jaysylvester
DB_PASSWORD=REPLACE_WITH_EXISTING_DEV_PASSWORD
DB_MAX=REPLACE_WITH_EXISTING_POOL_MAX
DB_CONNECTION_TIMEOUT_MILLIS=REPLACE_WITH_EXISTING_TIMEOUT

# Application mail settings
MAIL_SERVICE=REPLACE_WITH_EXISTING_MAIL_SERVICE
MAIL_AUTH_USER=REPLACE_WITH_EXISTING_MAIL_USER
MAIL_AUTH_PASS=REPLACE_WITH_EXISTING_MAIL_PASSWORD
MAIL_NAME=REPLACE_WITH_EXISTING_SENDER_NAME
MAIL_ADDRESS=REPLACE_WITH_EXISTING_DESTINATION_ADDRESS
MAIL_ADDRESS_NO_REPLY=REPLACE_WITH_EXISTING_NO_REPLY_ADDRESS

# Docker and PostgreSQL initialization. PostgreSQL 17 is the rehearsed target
# for the legacy PostgreSQL 13 database and preserves its encoding, locale,
# and timezone.
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=en_US.UTF-8
POSTGRES_TIMEZONE=America/New_York
POSTICO_PORT=5432

# Development BrowserSync and Gulp polling (the assets service receives only these).
BROWSERSYNC_HOST=dev.jaysylvester.com
GULP_USE_POLLING=true
GULP_POLLING_INTERVAL=500
