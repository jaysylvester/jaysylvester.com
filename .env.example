# Application credentials and deployment inputs. Keep .env ignored and protected.
# Citizen loads it for native execution and Docker development, in either app mode.
# Docker production uses .env as Compose input and mounts scoped secret files.
# Choose the PostgreSQL administrator password separately; never store it here.
NODE_ENV=development
BROWSERSYNC_ORIGIN=https://dev.jaysylvester.com

# App credentials only. Existing environments retain their current DB_PASSWORD
# and DB_USER; choose a separate postgres admin password interactively.
# Production exposes DB_PASSWORD through a Compose secret.
DB_DATABASE=jaysylvester
DB_USER=jaysylvester
DB_PASSWORD=REPLACE_WITH_EXISTING_APP_PASSWORD

# Retain this key locally for production-mode testing; development logs mail
# without sending it. Non-secret mail settings live in citizen.config.js.
MAIL_AUTH_PASS=REPLACE_WITH_EXISTING_MAIL_PASSWORD

# Docker and PostgreSQL initialization. PostgreSQL 17 is the rehearsed target
# for both source databases: PostgreSQL 13 in development and PostgreSQL 11 in
# production. Both use UTF-8 and en_US.UTF-8. Development uses America/New_York;
# production must change POSTGRES_TIMEZONE to Etc/UTC before its first start.
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=en_US.UTF-8
POSTGRES_TIMEZONE=America/New_York
POSTGRES_VOLUME=jaysylvester-postgres
DB_CLIENT_PORT=5432

# Development BrowserSync and Gulp inputs (the assets service receives only these).
GULP_USE_POLLING=true
GULP_POLLING_INTERVAL=500

# Optional: join the shared workstation edge proxy so several dev stacks can run at
# once (see ~/Projects/dev-edge). Leave unset to run this project standalone.
# DEV_EDGE=true
