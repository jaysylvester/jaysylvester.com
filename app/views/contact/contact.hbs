<header>
  <h1>I'm open to various product, design, and development roles, full-time or consulting. Let's discuss how I can help.</h1>
</header>
<section>
  <div>
    {{#if local.error}}<p class="form-error" id="form-error" role="alert">{{local.error}}</p>{{/if}}
    <form id="contact-form" action="/contact/action/form" method="post" novalidate {{#if local.error}}aria-describedby="form-error"{{/if}}>
      <input type="hidden" name="date" value="{{local.date}}">
      <div class="form-row">
        <label>Name<input name="name" value="{{form.name}}" autocomplete="name" required></label>
        <label>E-mail<input name="email" type="email" value="{{form.email}}" autocomplete="email" required></label>
      </div>
      <label>Subject<input name="subject" value="{{form.subject}}" autocomplete="off" required></label>
      <label>Message<textarea name="message" rows="7" required>{{form.message}}</textarea></label>
      <button class="primary-action" name="submit" type="submit"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" aria-hidden="true"><path d="M1.5 3.5h13v9h-13z"></path><path d="M1.5 3.5 8 9l6.5-5.5"></path></svg> Send your message</button>
    </form>
  </div>
  <aside aria-label="Contact channels">
    <a href="https://www.linkedin.com/in/jaysylvester" target="_blank" rel="noopener"><small>LinkedIn</small><span>linkedin.com/in/jaysylvester</span></a>
    <a href="https://github.com/jaysylvester" target="_blank" rel="noopener"><small>GitHub</small><span>github.com/jaysylvester</span></a>
    <a href="https://x.com/JayIsAngry" target="_blank" rel="noopener"><small>X</small><span>@JayIsAngry</span></a>
  </aside>
</section>
