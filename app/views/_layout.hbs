<!doctype html>
<html lang="en">
  {{{include.head}}}
  <body id="top" data-controller="{{route.controller}}" data-action="{{route.action}}">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-navigation" aria-label="Navigation">
      <a class="wordmark" href="/">Jay Sylvester</a>
      {{{include.header}}}
      {{{include.rail}}}
    </div>
    <div class="mobile-menu-overlay" id="site-menu" aria-label="Navigation menu" hidden>
      <a class="mobile-menu-wordmark" href="/">Jay Sylvester</a>
    </div>
    <main id="main-content" tabindex="-1">
      {{#each route.chain}}
        {{{output}}}
      {{/each}}
    </main>
    {{#if (eq config.citizen.mode "development")}}
      <script id="__bs_script__">//<![CDATA[
        (function() {
          try {
            var script = document.createElement('script');
            script.async = true;
            script.src = '/browser-sync/browser-sync-client.js?v=3.0.3';
            document.body.appendChild(script);
          } catch (e) {
            console.error("Browsersync: could not append script tag", e);
          }
        })()
      //]]></script>
    {{/if}}
  </body>
</html>
