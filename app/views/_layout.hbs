<!doctype html>
<html lang="en">
  {{{include.head}}}
  <body id="top" data-controller="{{route.controller}}" data-action="{{route.action}}">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {{{include.header}}}
    {{{include.rail}}}
    <main id="main-content" tabindex="-1">
      {{#each route.chain}}
        {{{output}}}
      {{/each}}
    </main>
    {{{include.footer}}}
    {{#if (eq config.citizen.mode "development")}}
      <script id="__bs_script__">//<![CDATA[
        (function() {
          try {
            var script = document.createElement('script');
            script.async = true;
            script.src = '/browser-sync/browser-sync-client.js?v=3.0.3';
            document.body.appendChild(script);
          } catch (e) {
            console.error("Browsersync: could not append script tag", e);
          }
        })()
      //]]></script>
    {{/if}}
  </body>
</html>
